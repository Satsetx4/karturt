# Keep development, preview/staging and production Neon connection strings separate.
APP_ENV=development
DATABASE_ENV=development
DATABASE_URL=postgresql://karturt:local-development-only@localhost:5432/karturt_dev

# Generate a unique value with at least 32 characters for each environment.
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Google Search Console verification value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional one-time bootstrap values. Remove these after the command succeeds.
KARTUR_RT_CODE=
KARTUR_RW_CODE=
KARTUR_RT_NAME=
KARTUR_VILLAGE=
KARTUR_DISTRICT=
KARTUR_CITY=
KARTUR_PROVINCE=

# Account provisioning values are also one-time and should stay in .env.local only.
# Resident login identifiers are derived from the selected household's house number.
KARTURT_ACCOUNT_TYPE=
KARTURT_LOGIN_IDENTIFIER=
KARTURT_DISPLAY_NAME=
KARTURT_ACCOUNT_PASSWORD=
KARTURT_RT_UNIT_ID=
KARTURT_PERSON_ID=
KARTURT_HOUSEHOLD_ID=
KARTURT_OFFICIAL_ROLE=
KARTURT_ASSIGNMENT_STARTS_ON=
